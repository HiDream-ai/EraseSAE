{
  "model_family": "cogvideo",
  "base_model_key": "cogvideox_5b",
  "architecture": "partitioned",
  "training": {
    "global_seed": 42,
    "use_bf16": true,
    "sae_save_dir": "checkpoints/cog/nudity",
    "target_layers": "3",
    "sae_epochs": 30,
    "batch_size": 8,
    "k_gen": 128,
    "k_id": 128,
    "n_gen_kernels": 3072,
    "n_id_per_celeb": 512,
    "partition_beta": 0.2,
    "leak_start_fraction": 0.3,
    "partition_contrast_weight": 0.5,
    "partition_contrast_margin": 0.1,
    "face_weight": 5.0,
    "aux_coeff": 0.05,
    "bg_exclusive_weight": 1.0,
    "temp_consistency": 0.5,
    "lr": 0.0004,
    "online_batch_reuse": 4,
    "wandb_name": "conv-sae-2n-cog"
  },
  "attribution": {
    "top_k": 32,
    "min_mining_purity": 70.0,
    "min_mining_kernels": 8,
    "min_mining_survival": 0.1,
    "min_mining_score": 0.000001,
    "max_empty_target_mask_fraction": 0.05,
    "skip_train": false,
    "target_concepts": "nudity,no_nudity",
    "data_save_dir": "outputs/data/cogvideox5b/train",
    "activation_source": "online",
    "activation_input": "prompt",
    "normalization_mode": "global",
    "raw_data_root": "data/train",
    "activation_num_frames": 32,
    "activation_height": 480,
    "activation_width": 720,
    "activation_timesteps_per_video": 3,
    "activation_timestep_min_index": 700,
    "activation_sampling_mode": "trajectory",
    "activation_trajectory_steps": 4,
    "attention_mask_quantile": 0.8,
    "attention_mask_dilation": 0,
    "max_samples_per_subject": null,
    "empty_cache_every_step": true
  },
  "inference": {
    "inference_steps": 50,
    "num_frames": 16,
    "height": 480,
    "width": 720,
    "guidance_scale": 6.0,
    "use_dynamic_cfg": true,
    "fps": 8,
    "mask_cfg_reference_prompt": "nudity",
    "mask_cfg_scale": 4.0,
    "mask_start_step": 5,
    "mask_end_step": null,
    "mask_background_threshold": 0.5,
    "mask_concept_threshold": 0.5,
    "mask_dilation": 1,
    "mask_mode": "intersection",
    "concept_gate_mode": "competition",
    "concept_gate_policy": "per_step",
    "competition_ratio": 1.05,
    "min_relative_score": 0.05,
    "score_top_fraction": 0.2
  }
}
